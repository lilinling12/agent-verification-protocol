{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:scenario-instance:0.1",
  "title": "AVP ScenarioInstance v0.1",
  "description": "Serialized materialized ScenarioInstance. instanceDigest is SHA-256 over RFC 8785 JCS canonical bytes after removing top-level instanceDigest and provenance.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "environment", "task", "instanceDigest"],
  "properties": {
    "apiVersion": {"const": "avp.spec/v0.1"},
    "kind": {"const": "ScenarioInstance"},
    "metadata": {"type": "object", "required": ["name", "version"], "additionalProperties": true},
    "environment": {"type": "object", "minProperties": 1},
    "actors": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "additionalProperties": true}},
    "capabilities": {"type": "object"},
    "task": {"type": "object", "required": ["instruction"], "additionalProperties": true},
    "initial": {"type": "object"},
    "success": {"type": "object"},
    "invariants": {"type": "array", "items": {"type": "object"}},
    "control": {"type": "object"},
    "trajectory": {"type": "object"},
    "budgets": {"type": "object"},
    "mutations": {"type": "object"},
    "metamorphic": {"type": "array", "items": {"type": "object"}},
    "faults": {"type": "object"},
    "security": {"type": "object"},
    "contamination": {"type": "object"},
    "validity": {"type": "object"},
    "coverage": {"type": "object"},
    "graders": {"type": "array", "items": {"type": "object"}},
    "privacy": {"type": "object"},
    "extensions": {"type": "object"},
    "referenceBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference", "identity", "identityType"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "identityType": {"enum": ["content", "version", "symbolic"]}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "description": "Non-semantic compilation/audit provenance. Excluded from instanceDigest and MUST NOT affect Episode execution semantics.",
      "type": "object",
      "additionalProperties": true
    },
    "instanceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
