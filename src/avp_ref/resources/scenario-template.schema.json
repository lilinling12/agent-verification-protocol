{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:scenario-template:0.1",
  "title": "AVP ScenarioTemplate v0.1",
  "description": "Authoring/input shape for an unresolved AVP ScenarioTemplate. Execution semantics are defined by the Scenario specification, not by authoring conveniences in this schema.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "environment", "task"],
  "properties": {
    "apiVersion": {"const": "avp.spec/v0.1"},
    "kind": {"const": "ScenarioTemplate"},
    "metadata": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "domain": {"type": "string"}, "languages": {"type": "array", "items": {"type": "string"}}, "risk": {"type": "object", "properties": {"level": {"enum": ["low", "medium", "high", "critical"]}, "tags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}, "additionalProperties": true},
    "parameters": {"type": "object"}, "seeds": {"type": "object"}, "environment": {"type": "object", "minProperties": 1}, "actors": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "additionalProperties": true}}, "capabilities": {"type": "object"},
    "task": {"type": "object", "required": ["instruction"], "properties": {"instruction": {"oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": {"type": "string"}}]}, "artifacts": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "initial": {"type": "object"}, "success": {"type": "object"}, "invariants": {"type": "array", "items": {"type": "object"}}, "control": {"type": "object"}, "trajectory": {"type": "object"}, "budgets": {"type": "object"}, "generators": {"type": "object"}, "mutations": {"type": "object"}, "metamorphic": {"type": "array", "items": {"type": "object"}}, "faults": {"type": "object"}, "security": {"type": "object"}, "contamination": {"type": "object"}, "validity": {"type": "object"}, "coverage": {"type": "object"}, "graders": {"type": "array", "items": {"type": "object"}}, "privacy": {"type": "object"}, "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
