{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:tck:schemas:conformance-case:0.1",
  "title": "AVP TCK Conformance Case Envelope",
  "type": "object",
  "required": ["apiVersion", "kind", "id", "status", "profile", "requirements", "type"],
  "properties": {
    "apiVersion": {"const": "avp.tck/v0.1"},
    "kind": {"const": "ConformanceCase"},
    "id": {"type": "string", "pattern": "^AVP-TCK-[A-Z0-9-]+-[0-9]{3}$"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AVP-[A-Z][A-Z0-9-]*-[0-9]{3}$"}},
    "type": {"enum": ["positive", "negative", "model", "semantic", "schema-and-semantic", "conditional"]}
  },
  "additionalProperties": true
}
