{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:tck:schemas:conformance-report:0.1",
  "title": "AVP TCK Conformance Report",
  "type": "object",
  "required": ["apiVersion", "kind", "profile", "tckRevision", "runner", "implementation", "cases", "summary"],
  "properties": {
    "apiVersion": {"const": "avp.tck/v0.1"},
    "kind": {"const": "ConformanceReport"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "profile": {"type": "string", "minLength": 1},
    "tckRevision": {"type": "string", "minLength": 1, "maxLength": 256},
    "runner": {"$ref": "#/$defs/componentIdentity"},
    "implementation": {"$ref": "#/$defs/componentIdentity"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseResult"}},
    "summary": {"type": "object", "required": ["total", "passed", "failed", "skipped"], "properties": {"total": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "componentIdentity": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "identity": {"type": "string", "minLength": 1, "maxLength": 512}}, "additionalProperties": false},
    "caseResult": {"type": "object", "required": ["id", "status", "requirements"], "properties": {"id": {"type": "string", "pattern": "^AVP-TCK-[A-Z0-9-]+-[0-9]{3}$"}, "status": {"enum": ["PASS", "FAIL", "SKIP"]}, "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AVP-[A-Z][A-Z0-9-]*-[0-9]{3}$"}}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}}, "detail": {"type": "string", "maxLength": 4096}, "skipReason": {"type": "string", "minLength": 1, "maxLength": 1024}}, "allOf": [{"if": {"properties": {"status": {"const": "SKIP"}}, "required": ["status"]}, "then": {"required": ["skipReason"]}}], "additionalProperties": false}
  },
  "additionalProperties": false
}
