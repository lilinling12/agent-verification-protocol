{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:tck:schemas:conformance-registry:0.1",
  "title": "AVP TCK Registry",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "profiles", "cases"],
  "properties": {
    "apiVersion": {"const": "avp.tck/v0.1"},
    "kind": {"const": "ConformanceRegistry"},
    "metadata": {"type": "object", "required": ["name", "version", "status"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "status": {"enum": ["draft", "active", "deprecated"]}}, "additionalProperties": false},
    "profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^conformance/tck/profiles/.+\\.ya?ml$"}}, "additionalProperties": false}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "path", "profile", "requirements"], "properties": {"id": {"type": "string", "pattern": "^AVP-TCK-[A-Z0-9-]+-[0-9]{3}$"}, "path": {"type": "string", "pattern": "^conformance/tck/cases/.+\\.ya?ml$"}, "profile": {"type": "string", "minLength": 1}, "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AVP-[A-Z][A-Z0-9-]*-[0-9]{3}$"}}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
