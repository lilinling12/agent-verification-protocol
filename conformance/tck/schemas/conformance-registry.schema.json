{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:tck:schemas:conformance-registry:0.1",
  "title": "AVP TCK Registry",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "cases"],
  "properties": {
    "apiVersion": {"const": "avp.tck/v0.1"},
    "kind": {"const": "TCKRegistry"},
    "metadata": {"type": "object", "required": ["version", "status"], "properties": {"version": {"type": "string", "minLength": 1}, "status": {"enum": ["draft", "active", "deprecated"]}}, "additionalProperties": false},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "path", "profile", "requirements", "applicability"], "properties": {"id": {"type": "string", "pattern": "^AVP-TCK-[A-Z0-9-]+-[0-9]{3}$"}, "path": {"type": "string", "pattern": "^conformance/tck/cases/.+\\.ya?ml$"}, "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AVP-[A-Z][A-Z0-9-]*-[0-9]{3}$"}}, "applicability": {"enum": ["mandatory", "conditional", "mixed"]}, "when": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
