{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:avp:schemas:event:0.1",
  "title":"AVP Verification Event",
  "type":"object",
  "required":["schema_version","event_id","event_type","episode_id","sequence","observed_at","plane"],
  "properties":{
    "schema_version":{"const":"0.1.0"},"event_id":{"type":"string","minLength":1},"event_type":{"type":"string","pattern":"^[a-z0-9_.-]+$"},"experiment_id":{"type":"string"},"episode_id":{"type":"string","minLength":1},"trace_id":{"type":"string"},"span_id":{"type":"string"},"parent_span_id":{"type":["string","null"]},"sequence":{"type":"integer","minimum":0},"logical_time":{"type":["integer","number","string","null"]},"observed_at":{"type":"string","format":"date-time"},"plane":{"enum":["orchestrator","agent","environment","evaluator","user","security","external"]},"actor":{"type":"object","additionalProperties":true},"payload":{"type":"object"},"payload_ref":{"type":"object","required":["uri"],"properties":{"uri":{"type":"string"},"digest":{"type":"string"},"media_type":{"type":"string"}},"additionalProperties":true},"evidence":{"type":"array","items":{"type":"object","required":["uri"],"additionalProperties":true}},"state":{"type":"object","additionalProperties":true},"security":{"type":"object"},"extensions":{"type":"object"}
  },
  "additionalProperties":false
}
