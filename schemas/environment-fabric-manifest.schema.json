{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:environment-fabric-manifest:0.1",
  "title": "AVP Environment Fabric Manifest",
  "description": "Immutable portable composition description for one Scenario-bound Environment Fabric instance.",
  "type": "object",
  "required": ["apiVersion", "kind", "environmentId", "scenarioInstanceDigest", "resources"],
  "properties": {
    "apiVersion": {"const": "avp.fabric/v0.1"},
    "kind": {"const": "EnvironmentFabricManifest"},
    "environmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scenarioInstanceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "environment-resource.schema.json"}
    }
  },
  "additionalProperties": false
}
