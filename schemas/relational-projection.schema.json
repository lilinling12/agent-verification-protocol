{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:relational-projection:0.1",
  "title": "AVP Relational Projection",
  "type": "object",
  "required": ["apiVersion", "kind", "manifestDigest", "projectionId", "relations"],
  "properties": {
    "apiVersion": {"const": "avp.relational/v0.1"},
    "kind": {"const": "RelationalProjection"},
    "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projectionId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "row": {
      "type": "object",
      "required": ["key", "values"],
      "properties": {
        "key": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "relational-value.schema.json"}},
        "values": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"$ref": "relational-value.schema.json"}}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["relationId", "rows"],
      "properties": {
        "relationId": {"$ref": "#/$defs/identifier"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
      },
      "additionalProperties": false
    }
  }
}
