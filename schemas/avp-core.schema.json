{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:avp:schemas:core:0.1",
  "title":"AVP Core Resource",
  "type":"object",
  "required":["apiVersion","kind","metadata"],
  "properties":{
    "apiVersion":{"const":"avp.spec/v0.1"},
    "kind":{"enum":["ScenarioTemplate","ScenarioInstance","Benchmark","EnvironmentManifest","AgentSystem","EpisodeManifest","OracleBundle","MutationSet","FaultProfile","ReleasePolicy"]},
    "metadata":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string"},"title":{"type":"string"},"description":{"type":"string"},"labels":{"type":"object","additionalProperties":{"type":"string"}}},"additionalProperties":true},
    "extensions":{"type":"object"}
  },
  "additionalProperties":true
}
