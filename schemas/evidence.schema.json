{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:evidence:0.1",
  "title": "AVP Evidence",
  "description": "Stable verification-domain Evidence identity referencing immutable Artifact content.",
  "type": "object",
  "required": ["evidenceId", "type", "artifact", "classification"],
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifact": {
      "$ref": "artifact-ref.schema.json"
    },
    "classification": {
      "enum": ["public", "workspace", "subject-visible", "evaluator-confidential", "secret", "regulated"]
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "redaction": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
