{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:relational-state-manifest:0.1",
  "title": "AVP Relational State Manifest",
  "type": "object",
  "required": ["apiVersion", "kind", "profile", "revision", "canonicalRepresentation", "relations", "projections"],
  "properties": {
    "apiVersion": {"const": "avp.relational/v0.1"},
    "kind": {"const": "RelationalStateManifest"},
    "profile": {"const": "avp-relational-state-v0.1"},
    "revision": {"const": "0.1"},
    "canonicalRepresentation": {"const": "rfc8785-jcs"},
    "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}},
    "projections": {"type": "array", "items": {"$ref": "#/$defs/projectionDefinition"}}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "columnType": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"enum": ["boolean", "integer", "text", "binary", "date", "uuid"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "precision", "scale"],
          "properties": {
            "type": {"const": "decimal"},
            "precision": {"type": "integer", "minimum": 1, "maximum": 65},
            "scale": {"type": "integer", "minimum": 0, "maximum": 30}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "fractionalPrecision"],
          "properties": {
            "type": {"enum": ["time-local", "timestamp-local", "timestamp-instant"]},
            "fractionalPrecision": {"type": "integer", "minimum": 0, "maximum": 6}
          },
          "additionalProperties": false
        }
      ]
    },
    "column": {
      "type": "object",
      "required": ["columnId", "nullable", "valueType"],
      "properties": {
        "columnId": {"$ref": "#/$defs/identifier"},
        "nullable": {"type": "boolean"},
        "valueType": {"$ref": "#/$defs/columnType"}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["relationId", "columns", "rowKey"],
      "properties": {
        "relationId": {"$ref": "#/$defs/identifier"},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}},
        "rowKey": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "additionalProperties": false
    },
    "projectionRelation": {
      "type": "object",
      "required": ["relationId", "columns"],
      "properties": {
        "relationId": {"$ref": "#/$defs/identifier"},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "additionalProperties": false
    },
    "projectionDefinition": {
      "type": "object",
      "required": ["projectionId", "relations"],
      "properties": {
        "projectionId": {"$ref": "#/$defs/identifier"},
        "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/projectionRelation"}}
      },
      "additionalProperties": false
    }
  }
}
