{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avp.dev/schemas/oracle-evaluation.schema.json",
  "title": "AVP Oracle Evaluation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "oracle",
    "inputDigest",
    "evaluationValidity",
    "taskVerdict",
    "acceptedResults",
    "evidenceIds"
  ],
  "properties": {
    "oracle": {"$ref": "#/$defs/oracleIdentity"},
    "inputDigest": {"$ref": "#/$defs/sha256"},
    "executionRecordDigest": {"$ref": "#/$defs/sha256"},
    "evaluationValidity": {
      "type": "string",
      "enum": ["VALID", "ORACLE_FAILURE"]
    },
    "validityDetail": {"$ref": "#/$defs/validityDetail"},
    "taskVerdict": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"]
    },
    "acceptedResults": {
      "type": "array",
      "items": {"$ref": "#/$defs/verificationResult"}
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evaluationValidity": {"const": "ORACLE_FAILURE"}},
        "required": ["evaluationValidity"]
      },
      "then": {
        "required": ["validityDetail"],
        "properties": {
          "taskVerdict": {"const": "INCONCLUSIVE"},
          "acceptedResults": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"evaluationValidity": {"const": "VALID"}},
        "required": ["evaluationValidity"]
      },
      "then": {
        "required": ["executionRecordDigest"],
        "not": {"required": ["validityDetail"]}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleId", "version", "packageDigest"],
      "properties": {
        "oracleId": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "packageDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "validityDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "dimension",
        "verdict",
        "severity",
        "method",
        "evaluatorVersion",
        "evidenceIds",
        "confidence",
        "validity"
      ],
      "properties": {
        "claimId": {"type": "string", "minLength": 1, "maxLength": 256},
        "dimension": {"type": "string", "minLength": 1, "maxLength": 256},
        "verdict": {
          "type": "string",
          "enum": ["PASS", "PARTIAL", "FAIL", "INCONCLUSIVE"]
        },
        "severity": {"type": "string", "minLength": 1, "maxLength": 128},
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "evaluatorVersion": {"type": "string", "minLength": 1, "maxLength": 256},
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "validity": {"const": "VALID"}
      }
    }
  }
}
