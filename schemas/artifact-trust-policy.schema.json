{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avp:schemas:artifact-trust-policy:0.1",
  "title": "AVP Artifact Trust Policy",
  "description": "Portable minimum evaluator-owned trust policy surface for Artifact attestation verification.",
  "type": "object",
  "required": ["policyId", "allowedSignerIdentities"],
  "properties": {
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "allowedSignerIdentities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "allowedBindingProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,255}$"
      }
    },
    "allowedPredicateTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
